<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BarberShopMobile.MainPage"
             BackgroundColor="#1e1e1e"
             Title="Barber Shop"> <Grid RowDefinitions="Auto, *">
        <Label Text="Echipa Noastră"
               TextColor="#d4af37"
               FontSize="28"
               FontAttributes="Bold"
               HorizontalOptions="Center"
               Margin="0,20,0,20" />

        <CollectionView x:Name="StylistsList"
                        Grid.Row="1"
                        Margin="15"
                        SelectionMode="Single"
                        SelectionChanged="OnStylistSelected">
            
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame BackgroundColor="#2a2a2a"
                           BorderColor="#d4af37"
                           CornerRadius="12"
                           Margin="0,0,0,15"
                           Padding="15">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup Name="CommonStates">
                                <VisualState Name="Normal" />
                                <VisualState Name="Selected">
                                    <VisualState.Setters>
                                        <Setter Property="BackgroundColor" Value="#d4af37" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <VerticalStackLayout>
                            <Label Text="{Binding Name}" 
                                   TextColor="White" 
                                   FontSize="22" 
                                   FontAttributes="Bold"/>
                            
                            <Label Text="{Binding Specialization}" 
                                   TextColor="#999" 
                                   FontSize="16"/>
                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>

</ContentPage>