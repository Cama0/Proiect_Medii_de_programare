@page
@model BarberShopWeb1.Pages.Reviews.DetailsModel

@{
    ViewData["Title"] = "Detalii Recenzie";
}

<div class="container mt-4">
    <h1 class="text-warning">Detalii Recenzie</h1>
    <hr style="background-color: #d4af37;" />

    <div class="card p-4 shadow mt-3" style="background-color: #1e1e1e; border: 1px solid #333;">
        <dl class="row text-white">
            <dt class="col-sm-3 text-muted">
                Client
            </dt>
            <dd class="col-sm-9 font-weight-bold">
                @(Model.Review.Member != null ? Model.Review.Member.FirstName + " " + Model.Review.Member.LastName : "Anonim")
            </dd>

            <dt class="col-sm-3 text-muted">
                Frizer
            </dt>
            <dd class="col-sm-9 text-info">
                @(Model.Review.Stylist != null ? Model.Review.Stylist.Name : "Nespecificat")
            </dd>

            <dt class="col-sm-3 text-muted">
                Nota
            </dt>
            <dd class="col-sm-9 text-warning" style="font-size: 1.2rem;">
                @for(int i=0; i < Model.Review.Rating; i++) 
                { 
                    <span>★</span> 
                }
                <span class="text-muted small ml-2">(@Model.Review.Rating / 5)</span>
            </dd>

            <dt class="col-sm-3 text-muted">
                Comentariu
            </dt>
            <dd class="col-sm-9 text-light font-italic">
                " @Html.DisplayFor(model => model.Review.Comment) "
            </dd>
        </dl>
    </div>

    <div class="mt-3">
        @if (User.IsInRole("Admin"))
        {
            <a asp-page="./Edit" asp-route-id="@Model.Review.ID" class="btn btn-warning">Editează</a> <span>|</span>
        }
        <a asp-page="./Index" class="text-white">Înapoi la Listă</a>
    </div>
</div>